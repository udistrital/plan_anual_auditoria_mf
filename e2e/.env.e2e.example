# Copiar a e2e/.env.e2e y llenar. e2e/.env.e2e NUNCA se versiona.
# Usuarios de prueba DEDICADOS del ambiente de pruebas (nunca personales ni de producción).
# Convención común a todos los MF: E2E_<ROL>_USER / E2E_<ROL>_PASS, donde <ROL> es el
# nombre del proyecto de Playwright en mayúsculas con "_" (jefe-dependencia → JEFE_DEPENDENCIA).
# Un rol sin usuario se omite: sus escenarios no se ejecutan.

# URL del root de SISIFO (local: el root en 4200 compone el MF en 4203)
E2E_BASE_URL=http://localhost:4200

E2E_AUDITOR_USER=
E2E_AUDITOR_PASS=

E2E_JEFE_DEPENDENCIA_USER=
E2E_JEFE_DEPENDENCIA_PASS=

# Programación (fase 1)
E2E_AUDITOR_EXPERTO_USER=
E2E_AUDITOR_EXPERTO_PASS=
E2E_JEFE_OCI_USER=
E2E_JEFE_OCI_PASS=
E2E_SECRETARIO_USER=
E2E_SECRETARIO_PASS=
E2E_ADMIN_USER=
E2E_ADMIN_PASS=

# Datos de Programación (opcional): vigencia con PAA aprobado (lectura) y vigencia dedicada a E2E (escritura).
E2E_PROG_VIGENCIA_APROBADA=2025
E2E_PROG_VIGENCIA_E2E=2010

# Datos (opcional): acción de un plan aprobado para los escenarios de registro de avances.
# Si se deja vacío, se toma la primera acción del listado de Gestión de acciones.
E2E_ACCION_ID=
